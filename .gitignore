# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/

# ==========================================
# Application Directory (Whitelist Approach)
# ==========================================
# 1. Ignore all contents inside the app directory
app/*

# 2. Allow and precisely filter _raw_input
!app/_raw_input/
app/_raw_input/*
!app/_raw_input/.gitkeep
!app/_raw_input/.processed/
app/_raw_input/.processed/*
!app/_raw_input/.processed/.gitkeep

